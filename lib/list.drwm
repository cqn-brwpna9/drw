# list structure:
# [head tail ,]
# Empty list is ,
# Most glyphs unabashedly stolen from uiua

# Cons
# head list -> list
⊂_,&B

# New list
# value -> list
⊏_,,@B

# Car
# list -> head
⊢_U&!!

# Cdr
# list -> tail
⊣_U!:!

# Unjoin (equivalent to `.⊢(⊣)`)
# list -> head tail
⊃_U@!

# Isempty. returns true on , and nothing else
# list -> empty?
⊓_,|

# Range from 1..=n
# n -> list
⇡_.⊏:1:-.[.&⊂:1:-]!

# Sum
# list -> sum
Σ_.⊣⊓1:[⊢!0][⊃:Σ+⊢]

# Product
# list -> product
Π_.⊣⊓1:[⊢!0][⊃:Π*⊢]

# Reduce/fold
# Σ and Π are faster than "+'∧ and "*'∧ (and faster for golfing)
# to fold, ⊂ the accumulator onto the list before ∧ing
# list quote -> reduction
∧_(.⊣⊓1:[)!⊢!0][⊃).(:(∧))`⊢]

# Length
# list -> length
⧻_.⊓1:[!!0 0][⊣⧻1+]

# Explode. push all of a list onto the stack, with length on top
# list -> length *items
◌_.⧻..(([⊃):((]!)[)])

# Reverse
# list -> list
⇌_◌1:-(⊏)[:⊂]

